# Port the FastAPI server listens on
PORT=7000

# Choose LLM provider: "ollama" or "gemini"
LLM_PROVIDER=ollama

# If using Gemini (Google): set your API key and preferred model
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# If using Ollama: model and local base URL
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_BASE_URL=http://localhost:11434

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- knowledge-copilot ---
# Embedding backend: "ollama" or "gemini"
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
GEMINI_EMBED_MODEL=gemini-embedding-001
# Where Chroma persists its index. Leave unset: the code defaults to
# <service dir>/chroma_data, which is correct no matter where you run from.
# If you do set it, use an ABSOLUTE path — a relative one resolves against the
# shell's cwd and will create a nested duplicate index when run from the
# service directory.
# CHROMA_PATH=/absolute/path/to/chroma_data