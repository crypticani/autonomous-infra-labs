# Port the FastAPI server listens on
PORT=7000

# Choose LLM provider: "ollama" or "gemini"
LLM_PROVIDER=ollama

# If using Gemini (Google): set your API key and preferred model
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# If using Ollama: model and local base URL
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_BASE_URL=http://localhost:11434

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- knowledge-copilot ---
# Port the copilot listens on. Only used by `python app.py`; the container and the
# compose command hardcode 7100.
COPILOT_PORT=7100

# Chat model for grounded answers. Note this is NOT OLLAMA_MODEL above -- that one is
# log-analyzer's. Both services read the same .env and each has its own key.
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct

# Seconds to wait for a generated answer. 120 was not enough: one grounded answer
# measured 195s against a warm qwen2.5:7b-instruct on CPU. Scales with k.
LLM_TIMEOUT=300

# Embedding backend: "ollama" or "gemini"
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
GEMINI_EMBED_MODEL=gemini-embedding-001

# Retrieval strategy: "dense", "lexical" or "hybrid". Anything else fails at import.
RETRIEVAL_MODE=hybrid

# Chunks scoring below this are dropped, and if nothing clears it the service refuses
# instead of calling the model. Set by `python eval_retrieval.py --floor-sweep` over 11
# answerable and 10 unanswerable cases: 0.64 is the unique minimum at 1 total error,
# against 2 at 0.65. Dropping to 0.60 -- which one anecdote seemed to argue for -- would
# admit 7 of the 10 unanswerable questions.
SIMILARITY_FLOOR=0.64
# Where Chroma persists its index. Leave unset: the code defaults to
# <service dir>/chroma_data, which is correct no matter where you run from.
# If you do set it, use an ABSOLUTE path — a relative one resolves against the
# shell's cwd and will create a nested duplicate index when run from the
# service directory.
# CHROMA_PATH=/absolute/path/to/chroma_data
# Bearer token for POST /ask-runbook. Empty means the endpoint is open, which /health
# reports as "auth": "disabled". Slack's own route authenticates by HMAC and ignores
# this. Generate with: openssl rand -hex 32
KC_API_TOKEN=

# --- Day 12: live alert connector ---
# Alertmanager's v2 API. Must be reachable from wherever the copilot runs.
ALERTMANAGER_URL=http://100.94.177.43:9093
ALERTMANAGER_TIMEOUT=10
# The in-app poll loop. Disable it (false) for CLI-only use, and in tests.
ALERT_SYNC_ENABLED=true
ALERT_SYNC_INTERVAL=60
# How long a resolved alert stays in the index before retention deletes it, so a
# question at 09:00 can still find what fired at 03:00.
ALERT_RETENTION_HOURS=24

# --- Day 13: Slack interface ---
# From the Slack app config: Basic Information -> Signing Secret, and
# OAuth & Permissions -> Bot User OAuth Token. Bot scopes: app_mentions:read,
# chat:write. Event subscription: app_mention.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-
# Opt-out flag, mirroring ALERT_SYNC_ENABLED. Slack is active only when this is true
# AND both values above are set -- otherwise POST /slack/events returns 404 and a
# warning is logged at startup. That is what keeps the offline test suite and a plain
# `python app.py` working with no credentials at all.
SLACK_ENABLED=true
# Seconds to wait on chat.postMessage.
SLACK_TIMEOUT=10

# A Slack thread is a session, held in memory only. A restart forgets every thread.
SESSION_TTL=3600
SESSION_MAX_TURNS=4

# --- docker compose ---
# docker-compose.prod.yml only: which published GHCR tag to run. The CI workflows push
# :latest, so that is the only tag that exists today -- set these to pin a deploy if you
# ever start pushing immutable tags.
# LOG_ANALYZER_TAG=latest
# KNOWLEDGE_COPILOT_TAG=latest

# The copilot container bind-mounts chroma_data from the host, and a bind mount keeps
# the HOST directory's uid rather than inheriting the image's. The image runs as
# appuser (uid 100), so compose overrides the container user to the host owner --
# which also lets the CLI and the container share one index. Uncomment only if
# `id -u` is not 1000.
# KC_UID=1000
# KC_GID=1000
