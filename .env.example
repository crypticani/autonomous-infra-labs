# Port the FastAPI server listens on
PORT=7000

# Choose LLM provider: "ollama" or "gemini"
LLM_PROVIDER=ollama

# If using Gemini (Google): set your API key and preferred model
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# If using Ollama: model and local base URL
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_BASE_URL=http://localhost:11434

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- knowledge-copilot ---
# Port the copilot listens on. Only used by `python app.py`; the container and the
# compose command hardcode 7100.
COPILOT_PORT=7100

# Chat model for grounded answers. Note this is NOT OLLAMA_MODEL above -- that one is
# log-analyzer's. Both services read the same .env and each has its own key.
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct

# Seconds to wait for a generated answer. 120 was not enough: one grounded answer
# measured 195s against a warm qwen2.5:7b-instruct on CPU. Scales with k.
LLM_TIMEOUT=300

# Embedding backend: "ollama" or "gemini"
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
GEMINI_EMBED_MODEL=gemini-embedding-001

# Retrieval strategy: "dense", "lexical" or "hybrid". Anything else fails at import.
RETRIEVAL_MODE=hybrid

# Chunks scoring below this are dropped, and if nothing clears it the service refuses
# instead of calling the model. Set by `python eval_retrieval.py --floor-sweep` over 11
# answerable and 10 unanswerable cases: 0.64 is the unique minimum at 1 total error,
# against 2 at 0.65. Dropping to 0.60 -- which one anecdote seemed to argue for -- would
# admit 7 of the 10 unanswerable questions.
SIMILARITY_FLOOR=0.64
# Where Chroma persists its index. Leave unset: the code defaults to
# <service dir>/chroma_data, which is correct no matter where you run from.
# If you do set it, use an ABSOLUTE path — a relative one resolves against the
# shell's cwd and will create a nested duplicate index when run from the
# service directory.
# CHROMA_PATH=/absolute/path/to/chroma_data
# Bearer token for POST /ask-runbook. Empty means the endpoint is open, which /health
# reports as "auth": "disabled". Slack's own route authenticates by HMAC and ignores
# this. Generate with: openssl rand -hex 32
KC_API_TOKEN=

# --- Day 12: live alert connector ---
# Alertmanager's v2 API. Must be reachable from wherever the copilot runs.
ALERTMANAGER_URL=http://100.94.177.43:9093
ALERTMANAGER_TIMEOUT=10
# The in-app poll loop. Disable it (false) for CLI-only use, and in tests.
ALERT_SYNC_ENABLED=true
ALERT_SYNC_INTERVAL=60
# How long a resolved alert stays in the index before retention deletes it, so a
# question at 09:00 can still find what fired at 03:00.
ALERT_RETENTION_HOURS=24

# --- Day 13: Slack interface ---
# From the Slack app config: Basic Information -> Signing Secret, and
# OAuth & Permissions -> Bot User OAuth Token. Bot scopes: app_mentions:read,
# chat:write. Event subscription: app_mention.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-
# Opt-out flag, mirroring ALERT_SYNC_ENABLED. Slack is active only when this is true
# AND both values above are set -- otherwise POST /slack/events returns 404 and a
# warning is logged at startup. That is what keeps the offline test suite and a plain
# `python app.py` working with no credentials at all.
SLACK_ENABLED=true
# Seconds to wait on chat.postMessage.
SLACK_TIMEOUT=10

# A Slack thread is a session, held in memory only. A restart forgets every thread.
SESSION_TTL=3600
SESSION_MAX_TURNS=4

# --- Day 15/16: self-healing agent ---
# Model for the agent's own diagnosis loop. Its own setting, not GEMINI_MODEL above --
# and deliberately a *different model name*, not just a separate variable. Both services
# still share one GEMINI_API_KEY (one project), and Gemini's free-tier quota is scoped
# per-project-*per-model* (quotaId GenerateRequestsPerDayPerProjectPerModel-FreeTier).
# Same model name here as GEMINI_MODEL means the copilot's Slack traffic and this
# service's diagnoses drain the same 20/day bucket without either one knowing it --
# discovered live on Day 21 when a diagnosis got quota-exhausted by traffic this service
# never sent. A distinct model name is what actually buys the isolation the separate
# variable only implied.
SHA_LLM_PROVIDER=gemini
# gemini-2.5-flash and gemini-2.5-flash-lite both 404 on this project -- "no longer
# available to new users." gemini-3.5-flash confirmed live: same flash tier as
# GEMINI_MODEL's 3.6, one generation back, so it is plausibly under less of the "high
# demand" 503 pressure the newest default gets.
SHA_GEMINI_MODEL=gemini-3.5-flash

# scale_deployment clamps a model-chosen replica count into this range rather than
# rejecting it outright. SHA_MIN_REPLICAS is also Day 19's replica-floor guard, which
# imports this same constant and *refuses* rather than clamping -- by then the number is
# in front of a human as a button, and quietly turning 0 into 1 would execute something
# nobody approved. One key, so the clamp and the hard stop cannot drift apart.
SHA_MIN_REPLICAS=1
SHA_MAX_REPLICAS=10

# Where the agent's search_runbooks tool reaches knowledge-copilot's /search-runbooks.
# Auth reuses KC_API_TOKEN above -- same door /ask-runbook uses, not a second secret.
#
# In a container this MUST be the compose service name, not localhost: `localhost` inside
# the agent is the agent. `host.docker.internal` does not work either, because the copilot
# publishes on 127.0.0.1:7100 only and the host gateway cannot reach a loopback binding --
# the compose network reaches the container port directly and needs no publishing at all.
# Use http://localhost:7100 only when running the agent with a bare `python app.py`.
SHA_KNOWLEDGE_COPILOT_URL=http://knowledge-copilot:7100
SHA_KNOWLEDGE_COPILOT_TIMEOUT=30

# --- Day 17: the diagnosis loop ---
# Bearer token for POST /diagnose. Empty means the endpoint is open. A separate secret
# from KC_API_TOKEN -- that one authenticates this service *to* the copilot; this one
# authenticates callers *of* this service. Generate with: openssl rand -hex 32
SHA_API_TOKEN=

# Was 6 (four read-only tools plus submit_diagnosis, one turn spare). Raised on evidence:
# a live diagnosis spent all six turns gathering and never reached submit_diagnosis, so the
# loop correctly returned incomplete rather than inventing one. Two of the four read-only
# tools fail whenever no cluster is reachable, and a single retry then eats the only spare.
SHA_MAX_ITERATIONS=10

# Port the agent listens on. Only used by `python app.py`; the container and the compose
# command default to 7200.
SHA_PORT=7200

# --- Day 18: human-in-the-loop approval ---
# Where the append-only audit log is written. Use an ABSOLUTE path in a container: the
# image creates /app/audit and compose bind-mounts it, because a safety record that dies
# with the container cannot answer "who approved that restart" a week later.
SHA_AUDIT_PATH=/app/audit/audit.jsonl

# How long a proposal stays approvable. An approval clicked the next morning is not
# consent for the cluster as it is now, so a stale click is refused rather than executed.
SHA_PROPOSAL_TTL=3600

# Channel id (not name) the approve/reject buttons are posted to. The bot must be in it.
# Empty means no proposal is ever posted -- write tools then have no path to execution
# at all, which is also what keeps the offline test suite and a plain `python app.py`
# working with no Slack credentials.
SHA_APPROVAL_CHANNEL=

# The agent reuses knowledge-copilot's Slack app: SLACK_SIGNING_SECRET, SLACK_BOT_TOKEN
# and SLACK_ENABLED above are read by both services. Set the app's Interactivity
# Request URL to https://<host>/slack/interactive -- that setting is global to the app,
# so it points at this service and not at the copilot.

# --- Day 19: guardrails ---
# Every value below is the shipped default; the whole block can stay commented out. All of
# them are read at import, so changing one needs `up -d --force-recreate`, not a restart.
# GET /health reports what the process actually loaded, which is the check worth running
# after a deploy.

# Namespaces the agent may act in, comma-separated. A second layer under RBAC, and the one
# readable without `kubectl auth can-i`. An EMPTY value refuses everything -- fail-closed,
# and not the same as "unset". This guard runs first, so an alert naming any other
# namespace produces no Slack button at all.
# SHA_NAMESPACES=sandbox

# Cluster writes allowed per window. Counted from audit.jsonl's `executed` and `failed`
# lines, so a proposal a guard blocked never spends the budget.
# SHA_MAX_ACTIONS_PER_HOUR=3

# Consecutive failed executions before the agent stops proposing anything at all. 0
# disables the breaker. Keep this >= SHA_MAX_ACTIONS_PER_HOUR only if you want the rate
# limit to be the usual answer: N failures is also N attempts, and the breaker is checked
# first precisely so it stays reachable when the two thresholds are equal.
# SHA_BREAKER_THRESHOLD=3

# Model calls per window, across ALL diagnoses -- not per diagnosis, which is what
# SHA_MAX_ITERATIONS already bounds. This is the ceiling that matters once Alertmanager
# drives /diagnose unattended: one flapping alert could otherwise spend the whole Gemini
# free tier before breakfast. Exceeding it answers 429, not 500 -- nothing is broken.
# SHA_MAX_LLM_CALLS=30

# The window the three counts above share. The breaker needs a time bound or it deadlocks:
# it blocks the only event that could close it, a successful execution. Bounded, it
# half-opens after a quiet hour instead of needing a reset nobody remembers exists.
# SHA_GUARD_WINDOW=3600

# --- Day 20: the alert webhook ---
# Also all shipped defaults, also read at import. POST /alerts is bearer-authed with the
# same SHA_API_TOKEN as /diagnose. The Alertmanager receiver config that points at it is
# not an env var and lives in Alertmanager's own config on appsrv -- see the "Wiring
# Alertmanager and Prometheus" section of services/self-healing-agent/Readme.md.

# How long the same alert is suppressed after it has been diagnosed once. Alertmanager
# re-sends a firing group every group_interval -- five minutes by default -- until it
# resolves, so without this one flapping alert is a fresh diagnosis every five minutes and
# the Gemini free tier is gone before anyone reads the first proposal. Keyed on
# Alertmanager's own fingerprint, falling back to the alert's labels. An hour, matching
# SHA_GUARD_WINDOW and SHA_PROPOSAL_TTL: all three answer "how long is this still the same
# incident". Suppression expires, so an alert still firing an hour later is looked at again.
# SHA_ALERT_DEDUP_TTL=3600

# Attempts per model call, including the first -- so 3 means one call and two retries.
# Only 429/500/502/503/504 are retried: those could succeed unchanged, while a 400 is a
# request this code built wrong and sending it twice more is three failures instead of one.
# A retry does NOT spend SHA_MAX_LLM_CALLS, because a 503 was never served -- otherwise an
# outage could drain the day's budget without producing a single diagnosis.
# SHA_MODEL_RETRIES=3

# Seconds before the first retry, doubling after: 1s then 2s. Bounded at 3s of added
# latency against a diagnosis that already runs for minutes.
# SHA_MODEL_RETRY_BACKOFF=1.0

# Requests per 60s this process paces itself to. The retry above cannot ride out Gemini's
# free-tier rate limit -- a live 429 on 2026-08-16 named the exact cap ("...PerMinute...
# FreeTier", value 5) and asked for a 51s wait, far past what 1s/2s of backoff covers. This
# waits *before* the next call instead of recovering after a refusal, so a 10-turn diagnosis
# takes longer but actually finishes. Change this only if the plan's real per-minute limit
# is known to differ from Gemini's free tier.
# SHA_MODEL_RATE_LIMIT=5

# --- Day 23: security triage ---
# Ollama, unlike self-healing-agent's default: no quota ceiling, and scan data (someone
# else's repo layout and dependency versions) never needs to leave the tailnet.
ST_LLM_PROVIDER=ollama

# Deliberately smaller than knowledge-copilot's qwen2.5:7b-instruct: the plan's own risk
# section calls for starting with a small model on CPU and letting Day 27's benchmark
# decide whether a bigger one is worth the latency.
ST_OLLAMA_MODEL=qwen2.5-coder:1.5b

# Own variable, not GEMINI_MODEL or SHA_GEMINI_MODEL -- see the comment above
# SHA_GEMINI_MODEL: Gemini's free-tier quota is scoped per-project-*per-model*, and Day
# 21 already lost a diagnosis to two services silently sharing one model name's bucket.
# Not the default provider, kept behind the same seam for Day 27's benchmark.
ST_GEMINI_MODEL=gemini-3.6-flash

# Findings per triage model call, not one call per finding -- 559 deduped findings in
# this repo's own fixture would otherwise be 559 calls. Small on purpose; Day 27 tunes
# this against real latency numbers instead of a guess.
ST_BATCH_SIZE=5

# Hard ceiling on Ollama's num_predict. Found live on 2026-08-19: greedy decoding
# (temperature 0) with no repetition penalty generated 3,613+ tokens for a batch that
# should have produced ~750 and never emitted a stop token, filling the 4096 context --
# what looked like slow hardware was actually an unbounded loop on any hardware. Sized
# at ~2x what one ST_BATCH_SIZE=5 batch needs; scale it if that default changes. Not the
# whole fix -- see triage.py's TriageResult.explanation and provider.py's
# repeat_penalty, both added the same day once num_predict alone still let a shorter
# repeating loop run to the token ceiling instead of stopping on its own.
ST_MAX_TOKENS=1536

# --- docker compose ---
# docker-compose.prod.yml only: which published GHCR tag to run. The CI workflows push
# :latest, so that is the only tag that exists today -- set these to pin a deploy if you
# ever start pushing immutable tags.
# LOG_ANALYZER_TAG=latest
# KNOWLEDGE_COPILOT_TAG=latest
# SELF_HEALING_AGENT_TAG=latest

# The copilot container bind-mounts chroma_data from the host, and a bind mount keeps
# the HOST directory's uid rather than inheriting the image's. The image runs as
# appuser (uid 100), so compose overrides the container user to the host owner --
# which also lets the CLI and the container share one index. Uncomment only if
# `id -u` is not 1000.
# KC_UID=1000
# KC_GID=1000

# Same problem, same fix, for the agent's audit directory.
# SHA_UID=1000
# SHA_GID=1000
