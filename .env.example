# --- shared ---
PORT=7000
LLM_PROVIDER=ollama

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Shared by all five services, so changing it moves every one of them. See
# ST_OLLAMA_BASE_URL to move only one. Ollama binds 127.0.0.1 by default; a remote host
# needs OLLAMA_HOST=<its tailnet ip> (or 0.0.0.0, which binds every interface).
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_BASE_URL=http://localhost:11434

LOG_LEVEL=INFO

# --- knowledge-copilot ---
# Only used by `python app.py`; the container hardcodes 7100.
COPILOT_PORT=7100

# NOT OLLAMA_MODEL above -- that one is log-analyzer's.
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct

# One grounded answer measured 195s on CPU. Scales with k.
LLM_TIMEOUT=300

EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
GEMINI_EMBED_MODEL=gemini-embedding-001

# "dense", "lexical" or "hybrid". Anything else fails at import.
RETRIEVAL_MODE=hybrid

# Below this the service refuses instead of calling the model. Set by
# `eval_retrieval.py --floor-sweep`: 0.64 is the unique minimum at 1 total error.
SIMILARITY_FLOOR=0.64

# Leave unset -- the code defaults to <service dir>/chroma_data. If you set it, use an
# ABSOLUTE path; a relative one creates a nested duplicate index.
# CHROMA_PATH=/absolute/path/to/chroma_data

# Bearer token for POST /ask-runbook. Empty means open. Slack's route uses HMAC instead.
KC_API_TOKEN=

# Alertmanager v2 API, reachable from wherever the copilot runs.
ALERTMANAGER_URL=http://localhost:9093
ALERTMANAGER_TIMEOUT=10
# Disable the poll loop (false) for CLI-only use and in tests.
ALERT_SYNC_ENABLED=true
ALERT_SYNC_INTERVAL=60
ALERT_RETENTION_HOURS=24

# Slack app config: Signing Secret, and Bot User OAuth Token. Bot scopes:
# app_mentions:read, chat:write. Event subscription: app_mention.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-
# Slack is active only when this is true AND both values above are set; otherwise
# /slack/events 404s, which is what keeps the offline suite working with no credentials.
SLACK_ENABLED=true
SLACK_TIMEOUT=10

# A Slack thread is a session, held in memory only.
SESSION_TTL=3600
SESSION_MAX_TURNS=4

# --- self-healing-agent ---
SHA_LLM_PROVIDER=gemini
# A distinct model *name*, not just a distinct variable: Gemini's free-tier quota is
# scoped per-project-per-model, so sharing a name with GEMINI_MODEL means two services
# draining one 20/day bucket. Lost a diagnosis to exactly that on Day 21.
SHA_GEMINI_MODEL=gemini-3.5-flash

# scale_deployment clamps a model-chosen count into this range. SHA_MIN_REPLICAS is also
# the replica-floor guard, which refuses rather than clamps -- one key so they cannot
# drift apart.
SHA_MIN_REPLICAS=1
SHA_MAX_REPLICAS=10

# In a container this MUST be the compose service name: `localhost` inside the agent is
# the agent, and host.docker.internal cannot reach the copilot's 127.0.0.1-only bind.
# Use http://localhost:7100 only with a bare `python app.py`.
SHA_KNOWLEDGE_COPILOT_URL=http://knowledge-copilot:7100
SHA_KNOWLEDGE_COPILOT_TIMEOUT=30

# Bearer token for POST /diagnose. Empty means open. Not KC_API_TOKEN -- that one
# authenticates this service *to* the copilot.
SHA_API_TOKEN=

# Raised from 6: a live diagnosis spent all six turns gathering and never concluded.
SHA_MAX_ITERATIONS=10

SHA_PORT=7200

# ABSOLUTE path in a container; the image creates /app/audit and compose mounts it.
SHA_AUDIT_PATH=/app/audit/audit.jsonl

# An approval clicked the next morning is not consent for the cluster as it is now.
SHA_PROPOSAL_TTL=3600

# Channel id (not name) for the approve/reject buttons; the bot must be in it. Empty
# means no proposal is ever posted, so write tools have no path to execution.
SHA_APPROVAL_CHANNEL=

# The agent reuses the copilot's Slack app. Set the app's Interactivity Request URL to
# https://<host>/slack/interactive -- that setting is global to the app.

# --- self-healing-agent guardrails (all shipped defaults) ---
# Read at import, so changing one needs `up -d --force-recreate`. GET /health reports
# what the process actually loaded.

# Comma-separated. EMPTY refuses everything -- fail-closed, not the same as unset.
# SHA_NAMESPACES=sandbox

# Counted from audit.jsonl, so a proposal a guard blocked never spends the budget.
# SHA_MAX_ACTIONS_PER_HOUR=3

# Consecutive failed executions before the agent stops proposing. 0 disables. Checked
# before the rate limit, so it stays reachable when the two thresholds are equal.
# SHA_BREAKER_THRESHOLD=3

# Across ALL diagnoses, not per diagnosis. The ceiling that matters once Alertmanager
# drives /diagnose unattended. Exceeding it answers 429, not 500.
# SHA_MAX_LLM_CALLS=30

# The window the three counts above share. The breaker needs a time bound or it
# deadlocks: it blocks the only event that could close it.
# SHA_GUARD_WINDOW=3600

# --- self-healing-agent alert webhook (all shipped defaults) ---
# POST /alerts uses the same SHA_API_TOKEN. The Alertmanager receiver config lives in
# Alertmanager's own config, not here.

# Alertmanager re-sends a firing group every group_interval until it resolves, so without
# this one flapping alert is a fresh diagnosis every five minutes.
# SHA_ALERT_DEDUP_TTL=3600

# Attempts per model call including the first. Only 429/500/502/503/504 are retried, and
# a retry does not spend SHA_MAX_LLM_CALLS -- a 503 was never served.
# SHA_MODEL_RETRIES=3

# 1s then 2s.
# SHA_MODEL_RETRY_BACKOFF=1.0

# Paced *before* the call, because backoff cannot ride out Gemini's per-minute free-tier
# cap: a live 429 asked for a 51s wait.
# SHA_MODEL_RATE_LIMIT=5

# --- security-triage ---
# Ollama, unlike the agent: no quota ceiling, and scan data never leaves the tailnet.
ST_LLM_PROVIDER=ollama

# 7B is the measured floor, not a guess. 1.5b returned five byte-identical boilerplate
# explanations and needs_human for everything, with valid JSON throughout. Do not lower
# this to make a demo faster; it stops being triage.
ST_OLLAMA_MODEL=qwen2.5-coder:7b

# Its own name for the per-model quota reason above SHA_GEMINI_MODEL. Deliberately not
# rolled out to the other three -- distinct names are distinct free-tier buckets.
ST_GEMINI_MODEL=gemini-3.7-flash

# Findings per model call. Set from Day 27's sweep; batch 10 is cheaper in tokens but
# runs 339.7s against the 600s ceiling, and the same config has varied 2x under load.
ST_BATCH_SIZE=5

# Ceiling on Ollama's num_predict, after an unbounded generation loop filled the context
# on 2026-08-19. Not the binding constraint on batch size -- ST_LLM_TIMEOUT is, much
# earlier, because wall clock is output-bound at ~2.5-3 tok/s.
ST_MAX_TOKENS=1536

# 600, not the copilot's 300: a batch of 5 measured 158.7s, 208.4s, then over 300s on the
# same input. A timeout wastes the whole run, and nothing here is latency-sensitive.
ST_LLM_TIMEOUT=600

ST_PORT=7300

# Comma-separated and plural: one token per onboarded repo, so revoking a leaked one is a
# list edit and the rate limit has something per-caller to count against. Unset means
# auth is OFF, which /health reports as degraded.
ST_API_TOKENS=

# Score at or above which the CI gate fails, 0-100. 40 is exactly one critical. Callers
# override per-request with `risk_threshold`.
ST_RISK_THRESHOLD=40

# How many findings the PR comment carries; the rest stay on GET /triage/{id}.
# ST_TOP_FINDINGS=10

# Body cap for POST /triage. Enforced as middleware on Content-Length -- a Depends()
# guard runs after FastAPI has parsed the body, too late to be a cap.
# ST_MAX_BODY_BYTES=16777216

# A repo whose CI retries a failed workflow four times would otherwise queue four full
# runs against a backend that can serve about one.
# ST_MAX_RUNS_PER_HOUR=5
# ST_RATE_WINDOW=3600

# Run records are a process-local dict, so it needs a ceiling. Oldest evicted first; an
# evicted id returns 404 to whoever was polling.
# ST_MAX_RUNS=200

# Overrides OLLAMA_BASE_URL for security-triage alone. Exists because appsrv runs all
# five services off this one file and only triage's backend moved to a laptop.
# ST_OLLAMA_BASE_URL=http://<laptop tailnet ip>:11434

# Distinct `repo` values that get their own Prometheus series before the rest fold into
# `other`. The one label whose values arrive in a request body, so it needs a ceiling.
# ST_MAX_REPO_LABELS=50

# --- gateway ---
GW_PORT=7500

# Comma-separated and plural, like ST_API_TOKENS: one token per caller, so revoking a
# leaked one is a list edit. Unset means auth is OFF -- and this is the front door to all
# four services, so /health reports that as degraded.
GW_API_TOKENS=

# Ollama, like security-triage and unlike the agent: no quota ceiling, and the routing
# question never leaves the tailnet. Gemini is the flip, not the default, because the free
# tier has already run out once mid-project.
GW_LLM_PROVIDER=ollama

# An instruct tune, not the coder model triage runs: this call classifies prose about
# incidents. 7b is the fail-safe default and eval_router.py is what may lower it -- Day 23
# showed 1.5b cannot write triage explanations, which is a much bigger job than picking
# one of four names.
GW_OLLAMA_MODEL=qwen2.5:7b-instruct

# Its own name for the per-model free-tier bucket, same reason as SHA_ and ST_.
GW_GEMINI_MODEL=gemini-3.7-flash-lite

# 120, not triage's 600. This is the only model call in the repo a human waits on
# synchronously, and a router that takes ten minutes is broken rather than slow.
GW_LLM_TIMEOUT=120

# A routing decision is a sentence and two fields; 256 is about 4x what it needs. The
# ceiling exists at all because an unbounded generation loop filled the context once.
GW_MAX_TOKENS=256

# The lowest confidence level the gateway acts on: low, medium or high. Under it the route
# is declined with the service it would have picked still named. `high` makes the router
# quieter and more often wrong by omission; `low` turns the floor off.
#
# Three levels and not a float, measured on 2026-08-26: a float's `ge/le` range is the one
# constraint a model's grammar cannot enforce, so both candidate models emitted out-of-range
# numbers and every one was a 502. An enum is structural. Anything but these three values
# fails at import rather than quietly disabling the floor.
GW_ROUTE_ON=medium

# Compose service names, because inside the gateway container `localhost` is the gateway
# and three of the four siblings bind 127.0.0.1 on the host. Use localhost ports only with
# a bare `python app.py`.
GW_LOG_ANALYZER_URL=http://log-analyzer:7000
GW_KNOWLEDGE_COPILOT_URL=http://knowledge-copilot:7100
GW_SELF_HEALING_AGENT_URL=http://self-healing-agent:7200
GW_SECURITY_TRIAGE_URL=http://security-triage:7300

# The gateway presents each backend's own token when it forwards. No new keys: these are
# KC_API_TOKEN, SHA_API_TOKEN and ST_API_TOKENS from the sections above, and log-analyzer
# has no auth of its own.

# 300 because the copilot is the slowest of the four and that is its own LLM_TIMEOUT. A
# shorter value here would invent a timeout the backend would not have had.
# GW_BACKEND_TIMEOUT=300

# Deliberately much shorter and a separate number: /health serves the container's own
# HEALTHCHECK, so a wedged backend must not hold it open. The four are polled
# concurrently, so this is the whole endpoint's worst case rather than four times it.
# GW_HEALTH_TIMEOUT=5

# Generous next to triage's 5/hour because a human is typing these. It exists because
# /ask spends a model call before any backend's own limit gets a say.
# GW_MAX_ASKS_PER_HOUR=60
# GW_RATE_WINDOW=3600

# Matches security-triage's cap, because the same scan envelope arrives here as an
# `attachment` and is then forwarded there. NOTE: nginx caps uploads at 1 MiB by default
# and sits in front of this, so it is the binding limit until client_max_body_size is
# raised.
# GW_MAX_BODY_BYTES=16777216

# How much of an attachment the router is shown. An alert or a scan envelope is real
# routing evidence and its first couple of hundred characters carry all of that signal.
# GW_ATTACHMENT_PREVIEW=200

# Overrides OLLAMA_BASE_URL for the gateway alone, same escape hatch as ST_'s.
# GW_OLLAMA_BASE_URL=http://<laptop tailnet ip>:11434

# --- docker compose ---
# docker-compose.prod.yml only. CI pushes :latest, so that is the only tag today.
# LOG_ANALYZER_TAG=latest
# KNOWLEDGE_COPILOT_TAG=latest
# SELF_HEALING_AGENT_TAG=latest
# SECURITY_TRIAGE_TAG=latest
# GATEWAY_TAG=latest

# Bind mounts keep the host directory's uid. Uncomment only if `id -u` is not 1000.
# KC_UID=1000
# KC_GID=1000
# SHA_UID=1000
# SHA_GID=1000
