# --- shared ---
PORT=7000
LLM_PROVIDER=ollama

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Shared by all five services. A remote Ollama needs OLLAMA_HOST set on its own host.
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_BASE_URL=http://localhost:11434

LOG_LEVEL=INFO

# --- knowledge-copilot ---
# `python app.py` only; the container hardcodes 7100.
COPILOT_PORT=7100

# NOT OLLAMA_MODEL above -- that one is log-analyzer's.
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct

# Scales with k. One grounded answer measured 195s on CPU.
LLM_TIMEOUT=300

EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
GEMINI_EMBED_MODEL=gemini-embedding-001

# "dense", "lexical" or "hybrid". Anything else fails at import.
RETRIEVAL_MODE=hybrid

# Below this the service refuses instead of calling the model. Set by
# `eval_retrieval.py --floor-sweep`.
SIMILARITY_FLOOR=0.64

# Leave unset. If you set it, use an ABSOLUTE path -- a relative one nests a duplicate index.
# CHROMA_PATH=/absolute/path/to/chroma_data

# Bearer token for POST /ask-runbook. Empty means open; Slack's route uses HMAC.
KC_API_TOKEN=

# Alertmanager v2 API, reachable from wherever the copilot runs.
ALERTMANAGER_URL=http://localhost:9093
ALERTMANAGER_TIMEOUT=10
# false for CLI-only use and in tests.
ALERT_SYNC_ENABLED=true
ALERT_SYNC_INTERVAL=60
ALERT_RETENTION_HOURS=24

# Bot scopes: app_mentions:read, chat:write. Event subscription: app_mention.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-
# Slack needs this true AND both values above set; otherwise /slack/events 404s.
SLACK_ENABLED=true
SLACK_TIMEOUT=10

# A Slack thread is a session, held in memory only.
SESSION_TTL=3600
SESSION_MAX_TURNS=4

# --- self-healing-agent ---
SHA_LLM_PROVIDER=gemini
# A distinct model *name*, not just a distinct variable: the free-tier quota is
# per-project-per-model, so a shared name drains one bucket twice.
SHA_GEMINI_MODEL=gemini-3.5-flash

# scale_deployment clamps a model-chosen count into this range. SHA_MIN_REPLICAS is also
# the replica-floor guard, which refuses rather than clamps.
SHA_MIN_REPLICAS=1
SHA_MAX_REPLICAS=10

# In a container this MUST be the compose service name. localhost only for `python app.py`.
SHA_KNOWLEDGE_COPILOT_URL=http://knowledge-copilot:7100
SHA_KNOWLEDGE_COPILOT_TIMEOUT=30

# Bearer token for POST /diagnose. Empty means open. Not KC_API_TOKEN -- that one
# authenticates this service *to* the copilot.
SHA_API_TOKEN=

SHA_MAX_ITERATIONS=10
SHA_PORT=7200

# ABSOLUTE path in a container; the image creates /app/audit and compose mounts it.
SHA_AUDIT_PATH=/app/audit/audit.jsonl

# An approval clicked the next morning is not consent for the cluster as it is now.
SHA_PROPOSAL_TTL=3600

# Channel id, not name; the bot must be in it. Empty means no proposal is ever posted, so
# write tools have no path to execution.
SHA_APPROVAL_CHANNEL=

# The agent reuses the copilot's Slack app. Its Interactivity Request URL must be
# https://<host>/slack/interactive -- that setting is global to the app.

# --- self-healing-agent guardrails (all shipped defaults) ---
# Read at import, so a change needs `up -d --force-recreate`. GET /health reports what
# the process actually loaded.

# Comma-separated. EMPTY refuses everything -- fail-closed, not the same as unset.
# SHA_NAMESPACES=sandbox

# Counted from audit.jsonl, so a blocked proposal never spends the budget.
# SHA_MAX_ACTIONS_PER_HOUR=3

# Consecutive failed executions before the agent stops proposing. 0 disables. Checked
# before the rate limit, so it stays reachable when the thresholds are equal.
# SHA_BREAKER_THRESHOLD=3

# Across ALL diagnoses, not per diagnosis. Exceeding it answers 429, not 500.
# SHA_MAX_LLM_CALLS=30

# The window the three counts above share. The breaker needs a time bound or it deadlocks.
# SHA_GUARD_WINDOW=3600

# --- self-healing-agent alert webhook (all shipped defaults) ---
# POST /alerts uses SHA_API_TOKEN. The receiver config lives in Alertmanager's own config.

# Alertmanager re-sends a firing group until it resolves; without this one flapping alert
# is a fresh diagnosis every five minutes.
# SHA_ALERT_DEDUP_TTL=3600

# Attempts per model call including the first. Only 429/500/502/503/504 are retried, and a
# retry does not spend SHA_MAX_LLM_CALLS.
# SHA_MODEL_RETRIES=3

# 1s then 2s.
# SHA_MODEL_RETRY_BACKOFF=1.0

# Paced *before* the call: backoff cannot ride out Gemini's per-minute free-tier cap.
# SHA_MODEL_RATE_LIMIT=5

# --- security-triage ---
# Ollama, unlike the agent: no quota ceiling, and scan data never leaves the tailnet.
ST_LLM_PROVIDER=ollama

# The measured floor. Do not lower it to make a demo faster; it stops being triage.
ST_OLLAMA_MODEL=qwen2.5-coder:7b

# Its own name for the per-model quota bucket, as with SHA_GEMINI_MODEL.
ST_GEMINI_MODEL=gemini-3.7-flash

# Findings per model call, set from Day 27's sweep. Raising it needs the timeout raised too.
ST_BATCH_SIZE=5

# Ceiling on Ollama's num_predict. Not the binding constraint on batch size -- the timeout
# is, much earlier.
ST_MAX_TOKENS=1536

# 600, not the copilot's 300: a batch of 5 has varied 2x on the same input.
ST_LLM_TIMEOUT=600

ST_PORT=7300

# Comma-separated and plural: one token per onboarded repo. Unset means auth is OFF, which
# /health reports as degraded.
ST_API_TOKENS=

# Score at or above which the CI gate fails, 0-100. Callers override per request.
ST_RISK_THRESHOLD=40

# How many findings the PR comment carries; the rest stay on GET /triage/{id}.
# ST_TOP_FINDINGS=10

# Enforced as middleware on Content-Length; a Depends() guard would run too late to cap.
# ST_MAX_BODY_BYTES=16777216

# A CI job that retries four times would otherwise queue four full runs.
# ST_MAX_RUNS_PER_HOUR=5
# ST_RATE_WINDOW=3600

# Run records are a process-local dict. Oldest evicted first; an evicted id 404s.
# ST_MAX_RUNS=200

# Overrides OLLAMA_BASE_URL for security-triage alone, whose backend is on the laptop.
# ST_OLLAMA_BASE_URL=http://<laptop tailnet ip>:11434

# Distinct `repo` values with their own Prometheus series before the rest fold into `other`.
# ST_MAX_REPO_LABELS=50

# --- gateway ---
GW_PORT=7500

# Comma-separated and plural, like ST_API_TOKENS. Unset means auth is OFF on the front
# door to all four services, which /health reports as degraded.
GW_API_TOKENS=

# Ollama by default; Gemini is the flip, because the free tier has run out once.
GW_LLM_PROVIDER=ollama

# An instruct tune, not triage's coder model: this call classifies prose. Set from
# eval_router.py -- 22/24 against 1.5b's 13/24.
GW_OLLAMA_MODEL=qwen2.5:7b-instruct

# Its own name for the per-model quota bucket.
GW_GEMINI_MODEL=gemini-3.7-flash-lite

# 120, not triage's 600: a human waits on this one synchronously.
GW_LLM_TIMEOUT=120

GW_MAX_TOKENS=256

# The lowest confidence level the gateway acts on: low, medium or high. Under it the route
# is declined with the service it would have picked still named. Anything else fails at
# import rather than quietly disabling the floor.
GW_ROUTE_ON=medium

# Compose service names; localhost ports only for `python app.py`.
GW_LOG_ANALYZER_URL=http://log-analyzer:7000
GW_KNOWLEDGE_COPILOT_URL=http://knowledge-copilot:7100
GW_SELF_HEALING_AGENT_URL=http://self-healing-agent:7200
GW_SECURITY_TRIAGE_URL=http://security-triage:7300

# No new keys for the tokens the gateway forwards: it reuses KC_API_TOKEN, SHA_API_TOKEN
# and ST_API_TOKENS above. log-analyzer has no auth of its own.

# Clears the copilot's own LLM_TIMEOUT, the slowest of the four.
# GW_BACKEND_TIMEOUT=300

# Separate and shorter: /health serves the container HEALTHCHECK, so a wedged backend must
# not hold it open.
# GW_HEALTH_TIMEOUT=5

# A human is typing these, so generous next to triage's 5/hour.
# GW_MAX_ASKS_PER_HOUR=60
# GW_RATE_WINDOW=3600

# Matches security-triage's cap; the same envelope arrives here and is forwarded there.
# NOTE: nginx caps uploads at 1 MiB by default and is the binding limit until raised.
# GW_MAX_BODY_BYTES=16777216

# How much of an attachment the router is shown as routing evidence.
# GW_ATTACHMENT_PREVIEW=200

# Overrides OLLAMA_BASE_URL for the gateway alone, as ST_OLLAMA_BASE_URL does for triage.
# GW_OLLAMA_BASE_URL=http://<laptop tailnet ip>:11434

# --- docker compose ---
# docker-compose.prod.yml only. CI pushes :latest, so that is the only tag today.
# LOG_ANALYZER_TAG=latest
# KNOWLEDGE_COPILOT_TAG=latest
# SELF_HEALING_AGENT_TAG=latest
# SECURITY_TRIAGE_TAG=latest
# GATEWAY_TAG=latest

# Bind mounts keep the host directory's uid. Uncomment only if `id -u` is not 1000.
# KC_UID=1000
# KC_GID=1000
# SHA_UID=1000
# SHA_GID=1000
